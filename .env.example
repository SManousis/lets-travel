# Local example configuration. Copy to .env (ignored by git) and replace every value before sharing a deployment.
# Never commit real secrets; deployments take them from Jenkins credentials, Ansible variables or Vault.

# PostgreSQL superuser (bootstrap only) and one database user per service.
POSTGRES_SUPERUSER=travelplan
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only
AUTH_DB_PASSWORD=change-me-auth
USERS_DB_PASSWORD=change-me-users
PAYMENTS_DB_PASSWORD=change-me-payments
ENGAGEMENT_DB_PASSWORD=change-me-engagement

# Graph and search stores.
NEO4J_PASSWORD=change-me-neo4j
ELASTICSEARCH_PASSWORD=change-me-elasticsearch

# Tokens: the signing secret needs at least 32 characters; the internal token protects /internal/** calls.
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token

# The first administrator, created at start-up (sign in with this e-mail address).
ADMIN_USERNAME=admin@example.test
ADMIN_PASSWORD=change-me-admin

# Payments. The test provider simulates approve/decline/timeout without real money (local and demo only).
PAYMENT_TEST_PROVIDER_ENABLED=true
PAYMENT_TEST_WEBHOOK_SECRET=change-me-test-webhook
# Optional sandbox credentials (only with compose.payment-sim.yml or real provider sandboxes).
# STRIPE_SANDBOX_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
